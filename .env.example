# =====================
# BACKEND CONFIGURATION
# =====================

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB_NAME=

# Redis Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated list of allowed origins for CORS (no spaces)
CORS_ORIGINS=http://localhost:7180

# ======================
# FRONTEND CONFIGURATION
# ======================

# Base URL for the API. Vite requires the VITE_ prefix to expose it to the browser.
VITE_API_URL=http://localhost:8000